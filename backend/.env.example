# Production: set the real value only in your hosting provider (Vercel) — never commit it.
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# JWT signing secret. Generate one with: openssl rand -hex 64
JWT_SECRET="replace-with-a-secure-random-secret"
JWT_EXPIRES_IN="1d"

# Allowed frontend origin (CORS). Local development default.
FRONTEND_URL="http://localhost:5173"

PORT="3000"